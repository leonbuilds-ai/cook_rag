# Copy to .env. Never commit actual passwords/API keys.
LLM_MODEL_ID=qwen3.5:9b
LLM_MODEL_TYPE=ollama
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434/v1
EMBED_MODEL_TYPE=openai
EMBED_MODEL_NAME=qwen3-embedding:8b
EMBED_API_KEY=ollama
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_BATCH_SIZE=8
QDRANT_URL=http://127.0.0.1:6335
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=recipe_c9
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-your-password
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_LIFETIME=3600
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT=10
# Optional Redis service: docker compose -p cook-rag-redis -f compose.redis.yaml up -d
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_USERNAME=default
REDIS_PASSWORD=replace-with-your-password
REDIS_URL=redis://default:replace-with-your-password@127.0.0.1:6379/0
POSTGRES_USER=cookrag
POSTGRES_DB=cookrag
POSTGRES_PASSWORD=replace-with-your-password
DATABASE_URL=postgresql+psycopg://cookrag:replace-with-your-password@127.0.0.1:5432/cookrag
# Enable only after validating the chosen model on your dataset.
RERANK_ENABLED=false
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# HF_HOME=runtime/models
HF_HUB_DISABLE_XET=1
RAGAS_DO_NOT_TRACK=true
# Optional HTTP authentication. Required before exposing /ask outside a trusted network.
APP_API_KEY=
# API_HOST=127.0.0.1
# API_PORT=8000
# HISTORY_DB_PATH=runtime/history.sqlite3
# RAG_CONFIG=settings.toml
# RETRIEVAL_MODE=recipe
